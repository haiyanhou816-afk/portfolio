<!-- 外观设置：日间 / 夜晚 / 自动 + 夜间底色 + 深度 + 强调色，两个页面共用 -->
<div class="theme-ctrl" id="themeCtrl">
  <button class="theme-btn" id="themeBtn" type="button" aria-label="外观设置" aria-expanded="false" title="外观设置"></button>

  <div class="theme-tip" id="themeTip" hidden>点这里切换夜晚模式与配色</div>

  <div class="theme-pop" id="themePop" hidden>
    <div class="tp-head"><b>外观</b><button type="button" id="themeClose" aria-label="关闭">×</button></div>

    <div class="tp-label"><span>模式</span><em id="themeModeHint"></em></div>
    <div class="tp-seg" id="themeModes">
      <button type="button" data-mode="light">日间</button>
      <button type="button" data-mode="night">夜晚</button>
      <button type="button" data-mode="auto">自动</button>
    </div>

    <div class="tp-label"><span>夜间底色</span><em>仅夜晚生效</em></div>
    <div class="tp-tones" id="themeTones">
      <button type="button" class="tp-tone" data-tone="neutral"><i data-tone="neutral"></i>中性</button>
      <button type="button" class="tp-tone" data-tone="cool"><i data-tone="cool"></i>冷蓝</button>
      <button type="button" class="tp-tone" data-tone="warm"><i data-tone="warm"></i>暖褐</button>
    </div>

    <div class="tp-label"><span>夜间深度</span><em id="themeDepthVal">标准</em></div>
    <input class="tp-range" type="range" id="themeDepth" min="3" max="14" step="1" value="6" aria-label="夜间深度">

    <div class="tp-label"><span>强调色</span><em id="themeAccentVal">跟随外观</em></div>
    <div class="tp-swatches" id="themeSwatches">
      <button type="button" class="tp-swatch default" data-accent="" title="跟随外观" aria-label="跟随外观"></button>
      <button type="button" class="tp-swatch" data-accent="#0071e3" style="--c:#0071e3" title="经典蓝" aria-label="经典蓝"></button>
      <button type="button" class="tp-swatch" data-accent="#5e5ce6" style="--c:#5e5ce6" title="靛紫" aria-label="靛紫"></button>
      <button type="button" class="tp-swatch" data-accent="#ff375f" style="--c:#ff375f" title="玫红" aria-label="玫红"></button>
      <button type="button" class="tp-swatch" data-accent="#ff9f0a" style="--c:#ff9f0a" title="琥珀" aria-label="琥珀"></button>
      <button type="button" class="tp-swatch" data-accent="#30d158" style="--c:#30d158" title="青绿" aria-label="青绿"></button>
      <button type="button" class="tp-swatch" data-accent="#40c8e0" style="--c:#40c8e0" title="湖蓝" aria-label="湖蓝"></button>
      <button type="button" class="tp-swatch" data-accent="#8e8e93" style="--c:#8e8e93" title="石墨" aria-label="石墨"></button>
    </div>
    <label class="tp-custom"><span>自定义颜色</span><input type="color" id="themeCustom" value="#0a84ff" aria-label="自定义强调色"></label>

    <button type="button" class="tp-reset" id="themeReset">恢复默认</button>
    <div class="tp-foot">设置保存在本机浏览器，两个页面同步生效</div>
  </div>
</div>

<script>
(function () {
  'use strict';
  var T = window.PortfolioTheme;
  if (!T) return;
  var ctrl = document.getElementById('themeCtrl');
  var btn = document.getElementById('themeBtn');
  var pop = document.getElementById('themePop');
  var tip = document.getElementById('themeTip');
  var depth = document.getElementById('themeDepth');
  var custom = document.getElementById('themeCustom');
  var SEEN = 'portfolio-admin-appearance-seen';

  var MOON = '<svg viewBox="0 0 24 24"><path d="M20.4 14.6A8.6 8.6 0 019.4 3.6 8.6 8.6 0 1012 20.5a8.6 8.6 0 008.4-5.9z"/></svg>';
  var SUN = '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M4.6 4.6L6 6M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4L6 18M18 6l1.4-1.4"/></svg>';

  /* 放进顶栏操作区；若页面结构不同则退回右下角浮动按钮 */
  var actions = document.querySelector('.top-actions');
  if (actions) actions.insertBefore(ctrl, actions.firstChild);
  else ctrl.classList.add('floating');

  function setOpen(open) {
    pop.hidden = !open;
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    if (open) hideTip();
  }
  function hideTip() {
    tip.hidden = true;
    try { localStorage.setItem(SEEN, '1'); } catch (e) {}
  }
  function depthName(v) {
    if (v <= 5) return '更深 · ' + v;
    if (v <= 8) return '标准 · ' + v;
    return '更柔和 · ' + v;
  }
  function render(s, dark) {
    btn.innerHTML = dark ? SUN : MOON;
    btn.title = '外观设置 · 当前' + (dark ? '夜晚' : '日间');
    document.getElementById('themeModeHint').textContent =
      s.mode === 'auto' ? ('跟随系统 · ' + (dark ? '夜晚' : '日间')) : (dark ? '夜晚模式' : '日间模式');
    document.querySelectorAll('#themeModes button').forEach(function (b) {
      b.classList.toggle('on', b.dataset.mode === s.mode);
    });
    document.querySelectorAll('#themeTones button').forEach(function (b) {
      b.classList.toggle('on', b.dataset.tone === s.tone);
    });
    depth.value = s.depth;
    document.getElementById('themeDepthVal').textContent = depthName(s.depth);
    document.querySelectorAll('#themeSwatches button').forEach(function (b) {
      var a = b.dataset.accent || null;
      b.classList.toggle('on', a === s.accent);
    });
    document.getElementById('themeAccentVal').textContent = s.accent ? s.accent.toUpperCase() : '跟随外观';
    if (document.activeElement !== custom) custom.value = s.accent || (dark ? '#0a84ff' : '#0071e3');
  }
  T.onChange(render);

  btn.addEventListener('click', function (e) { e.stopPropagation(); setOpen(pop.hidden); });
  document.getElementById('themeClose').addEventListener('click', function () { setOpen(false); });
  pop.addEventListener('click', function (e) { e.stopPropagation(); });
  document.addEventListener('click', function () { setOpen(false); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') setOpen(false); });

  document.getElementById('themeModes').addEventListener('click', function (e) {
    var b = e.target.closest('button[data-mode]');
    if (b) T.set({ mode: b.dataset.mode });
  });
  document.getElementById('themeTones').addEventListener('click', function (e) {
    var b = e.target.closest('button[data-tone]');
    if (b) T.set({ tone: b.dataset.tone });
  });
  depth.addEventListener('input', function () { T.set({ depth: Number(depth.value) }); });
  document.getElementById('themeSwatches').addEventListener('click', function (e) {
    var b = e.target.closest('button[data-accent]');
    if (b) T.set({ accent: b.dataset.accent || null });
  });
  custom.addEventListener('input', function () { T.set({ accent: custom.value }); });
  document.getElementById('themeReset').addEventListener('click', function () { T.reset(); });

  /* 首次访问给一个可消失的提示，让夜晚模式容易被发现 */
  var seen = false;
  try { seen = !!localStorage.getItem(SEEN); } catch (e) {}
  if (!seen) {
    tip.hidden = false;
    setTimeout(hideTip, 7000);
  }
})();
</script>
<script>
/* 发布平台的分享链接靠 URL 上的 sharecode 放行，跳转后容易被网关判为「链接不完整」。
   浏览器地址栏里还有这个参数时，给所有站内链接自动补上，避免点侧栏就 403 白屏。 */
(function () {
  try {
    var sc = new URLSearchParams(location.search).get('sharecode');
    if (!sc) return;
    document.querySelectorAll('a[href^="/"]').forEach(function (a) {
      var href = a.getAttribute('href');
      if (!href || href.indexOf('sharecode=') >= 0) return;
      var u = new URL(href, location.origin);
      if (u.origin !== location.origin) return;
      u.searchParams.set('sharecode', sc);
      a.setAttribute('href', u.pathname + u.search + u.hash);
    });
  } catch (e) {}
})();
</script>
