<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#f5f5f7">
<title>网站总览 · Portfolio Admin</title>
<%- include('theme-boot') %>
<%- include('admin-style') %>
<style>
.ov-strip{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin:0 0 18px}
.ov-card{background:var(--card);border-radius:14px;box-shadow:var(--shadow);padding:14px 16px;position:relative;overflow:hidden}
.ov-card .k{font-size:10.5px;color:var(--muted);display:flex;align-items:center;justify-content:space-between;gap:6px}
.ov-card .k a{font-size:10px;color:var(--accent);text-decoration:none;font-weight:600}
.ov-card .v{font-size:21px;font-weight:650;letter-spacing:-.6px;margin-top:7px;font-variant-numeric:tabular-nums}
.ov-card .v.bad{color:var(--danger)}
.ov-card .v.small{font-size:13px;font-weight:600;line-height:1.5;word-break:break-all}
.ov-card .s{font-size:10px;color:var(--faint);margin-top:4px;line-height:1.5}
.ref-row{display:flex;align-items:center;gap:10px;padding:9px 0;border-bottom:1px solid var(--line-soft);font-size:11.5px}
.ref-row:last-child{border-bottom:0}
.ref-row .host{flex:1;color:var(--ink-2);word-break:break-all}
.ref-row .cnt{font-variant-numeric:tabular-nums;color:var(--muted);min-width:52px;text-align:right}
.ref-tag{font-size:10px;padding:2px 8px;border-radius:6px;background:var(--fill-1);color:var(--muted);white-space:nowrap}
.ref-tag.ok,.ref-tag.info,.ref-tag.violet{background:var(--accent-soft);color:var(--accent-ink)}
.ref-tag.amber{background:var(--amber-soft);color:var(--ink-2)}
@media(max-width:1100px){.ov-strip{grid-template-columns:repeat(2,1fr)}}
/* 参考图里的胶囊按钮：白色主按钮 + 深色次按钮 */
#openSite{
  height:46px!important;min-width:158px;padding:0 24px!important;
  display:inline-flex;align-items:center;justify-content:center;gap:10px;
  border-radius:999px!important;background:#f5f5f5!important;color:#08080a!important;
  font-size:14px!important;font-weight:650!important;letter-spacing:.01em;
  box-shadow:0 8px 22px rgba(0,0,0,.28)!important;
  transition:background .2s ease,transform .2s ease!important;
}
#openSite::after{content:"→";font-size:18px;line-height:1;font-weight:400;opacity:.9}
#openSite:hover{background:#fff!important;transform:translateY(-1px)}
#openSite:active{transform:translateY(0)}
.top-actions > .btn.ghost{
  height:46px!important;min-width:108px;padding:0 22px!important;
  border-radius:999px!important;background:#151517!important;color:#f4f4f5!important;
  font-size:14px!important;font-weight:600!important;
  box-shadow:inset 0 0 0 1px rgba(255,255,255,.14)!important;
  transition:background .2s ease!important;
}
.top-actions > .btn.ghost:hover{background:#1d1d20!important}
/* ScrollFloat · 大号文字滚动上浮 */
.scroll-float-band{
  position:relative;display:grid;place-items:center;min-height:230px;
  margin:0 0 18px;padding:34px 20px;overflow:hidden;
  border-bottom:1px solid var(--line-soft);
}
.scroll-float-band__hint{
  position:absolute;top:18px;left:50%;transform:translateX(-50%);
  color:var(--faint);font-size:10px;letter-spacing:.18em;white-space:nowrap;
}
.scroll-float-band__title{
  margin:0!important;color:var(--ink)!important;
  font-size:clamp(52px,10vw,132px)!important;font-weight:650!important;
  letter-spacing:-.055em!important;line-height:1!important;white-space:nowrap;
  text-align:center;
}
.scroll-float-band__title .sf-char{
  display:inline-block;opacity:0;
  transform:translateY(120%) scaleY(2.3) scaleX(.62);
  transform-origin:50% 0;
  transition:transform 1s cubic-bezier(.68,-.55,.27,1.55),opacity 1s ease;
}
.scroll-float-band.is-visible .sf-char{opacity:1;transform:translateY(0) scaleY(1) scaleX(1)}
@media(prefers-reduced-motion:reduce){
  .scroll-float-band__title .sf-char{opacity:1;transform:none;transition:none}
}
/* 异常提醒 */
.alerts{display:flex;flex-direction:column;gap:8px;margin:0 0 16px}
.alert{display:flex;align-items:center;gap:10px;padding:11px 14px;border-radius:12px;background:var(--amber-soft);color:var(--ink-2);font-size:12.5px}
.alert svg{flex:0 0 auto;width:16px;height:16px}
.alert b{font-weight:650;margin-right:6px;color:var(--ink)}
.alert span{color:var(--muted)}
.alert a{margin-left:auto;white-space:nowrap;color:var(--accent);text-decoration:none;font-weight:600}
.alert.bad{background:var(--danger-soft);color:var(--danger-ink)}
.alert.bad b{color:var(--danger-ink-strong)}
/* 数据工具条 */
.toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:-4px 0 18px;font-size:11.5px;color:var(--faint)}
.btn.sm{height:34px!important;min-width:0!important;padding:0 14px!important;font-size:12px!important;text-decoration:none;display:inline-flex;align-items:center;justify-content:center}
/* 趋势范围切换 */
.panel-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}
.seg{display:inline-flex;padding:3px;border-radius:999px;background:var(--fill-2);gap:2px;flex:0 0 auto;margin:0 0 18px}
.seg button{border:0;background:transparent;color:var(--muted);font-size:11.5px;padding:5px 11px;border-radius:999px;cursor:pointer;font-weight:550;font-family:inherit}
.seg button.on{background:var(--card);color:var(--ink);box-shadow:var(--shadow)}
.chart[hidden]{display:none!important}
.chart[data-chart="30"]{overflow-x:auto}
.chart[data-chart="30"] .bar-col{min-width:15px}
.chart[data-chart="30"] .bar-col .v,.chart[data-chart="30"] .bar-col .x{font-size:9px}
/* 设备分布 */
.devices{margin-top:16px;padding-top:14px;border-top:1px solid var(--line-soft);display:flex;flex-direction:column;gap:9px}
.device-row{display:flex;align-items:center;gap:10px;font-size:11.5px}
.device-row .dl{min-width:34px;color:var(--ink-2)}
.device-row .dbar{flex:1;height:6px;border-radius:99px;background:var(--fill-2);overflow:hidden}
.device-row .dbar i{display:block;height:100%;border-radius:99px;background:var(--accent)}
.device-row .dc{min-width:30px;text-align:right;color:var(--muted)}
@media(max-width:720px){
  .toolbar{flex-direction:column;align-items:center;gap:10px;text-align:center}
  .seg{align-self:center}
}
</style>
</head>
<body>

<aside class="side">
  <div class="logo">
    <div class="logo-mark">P</div>
    <div><b>我的网站</b></div>
  </div>
  <div class="nav-label">监测</div>
  <nav class="nav">
    <a class="on" href="/online"><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3.5 3 14.5 0 18M12 3c-3 3.5-3 14.5 0 18"/></svg>网站总览</a>
    <a href="/monitor"><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 5-3.4 8.2-8 9-4.6-.8-8-4-8-9V6l8-3z"/><path d="M9 12l2 2 4-4"/></svg>访客详情</a>
    <a href="/dashboard"><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>本地数据</a>
    <a href="/api-explorer"><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M8 4H5a2 2 0 00-2 2v3M16 4h3a2 2 0 012 2v3M8 20H5a2 2 0 01-2-2v-3M16 20h3a2 2 0 002-2v-3"/><circle cx="12" cy="12" r="2.5"/></svg>数据接口</a>
  </nav>
  <div class="nav-label">系统</div>
  <nav class="nav">
    <a href="/health"><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 5-3.4 8.2-8 9-4.6-.8-8-4-8-9V6l8-3z"/><path d="M9 12l2 2 4-4"/></svg>运行状况</a>
    <a href="/setup"><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h9M17 7h3M4 17h3M11 17h9"/><circle cx="15" cy="7" r="2"/><circle cx="9" cy="17" r="2"/></svg>数据设置</a>
  </nav>
  <div class="side-foot">
    <div class="live"><i></i>网站正常</div>
    数据实时同步
  </div>
</aside>

<main class="main">
  <header class="top">
    <div class="crumb">我的网站 · 访问情况</div>
    <div class="top-actions">
      <div class="badge <%= stats.ok ? '' : 'warn' %>"><i></i><%= stats.ok ? '数据正常' : (stats.configured ? '拉取失败' : '等待配置') %></div>
      <button class="btn ghost" onclick="location.reload()">刷新</button>
      <button class="btn" id="openSite">打开网站</button>
    </div>
  </header>

  <div class="source-tabs">
    <a class="on" href="/online">网站总览</a>
    <a href="/monitor">访客详情</a>
    <a href="/dashboard">本地数据</a>
    <a href="/api-explorer">数据接口</a>
    <a href="/health">运行状况</a>
    <a href="/setup">数据设置</a>
  </div>

  <section class="scroll-float-band" aria-label="网站总览">
    <div class="scroll-float-band__hint">数据来自真实的浏览器访问</div>
    <h2 class="scroll-float-band__title" data-scroll-float>网站总览</h2>
  </section>

  <!-- 入口与安全概览：只有聚合数字，不含 IP / UA 明细；明细在受密码保护的 /monitor -->
  <section class="ov-strip">
    <div class="ov-card">
      <div class="k">总访问</div>
      <div class="v"><%= overview.total %></div>
      <div class="s">所有打开都算</div>
    </div>
    <div class="ov-card">
      <div class="k">真人来了</div>
      <div class="v"><%= overview.humans %></div>
      <div class="s"><%= overview.topChannel ? '大多是' + overview.topChannel.label : '暂无真人访问' %></div>
    </div>
    <div class="ov-card">
      <div class="k">机器人</div>
      <div class="v"><%= overview.robots %></div>
      <div class="s">搜索引擎之类的</div>
    </div>
    <div class="ov-card">
      <div class="k">可疑访问</div>
      <div class="v <%= overview.threats ? 'bad' : '' %>"><%= overview.threats %></div>
      <div class="s"><%= overview.attacks ? '发现 ' + overview.attacks + ' 次攻击' : '没发现攻击' %></div>
    </div>
    <div class="ov-card">
      <div class="k">当前版本 <a href="/monitor#releases">迭代 →</a></div>
      <div class="v small"><%= overview.currentVersion || '尚未上报' %></div>
      <div class="s"><%= overview.lastRelease ? '登记于 ' + overview.lastRelease.deployedAt.toLocaleDateString('zh-CN') : '接入 beacon 后自动追踪' %></div>
    </div>
  </section>

  <% if (!stats.configured) { %>
  <div class="notice">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 9v4M12 17h.01"/><circle cx="12" cy="12" r="9"/></svg>
    <div><b>还没有配置 Cloudflare 凭证，页面不会显示任何数字。</b> 这个后台不会用模拟数据填充空白 —— <a href="/setup" style="color:var(--accent);text-decoration:none;font-weight:600">现在去填写 →</a> 配齐下面三项后，数据直接来自 Cloudflare Web Analytics 的真实浏览器 beacon。</div>
  </div>
  <div class="setup">
    <div class="setup-main">
      <div class="guide">
        <div class="guide-head">
          <div class="eyebrow">Setup · 4 steps</div>
          <h2>接通 Cloudflare 真实数据</h2>
          <p class="lead">监测目标 <code><%= stats.host %></code>，站点地址 <code><%= siteUrl %></code>。浏览数据由 Cloudflare Web Analytics 在浏览器侧采集，本机只负责读取，不需要公网后端。</p>
        </div>
        <div class="steps">
          <div class="step">
            <div class="step-n">01</div>
            <div class="step-body">
              <h3>从项目页开启 Web Analytics</h3>
              <p>Cloudflare 后台 → <b>Workers &amp; Pages</b> → 打开这个 Pages 项目 → <b>Metrics</b> 标签 → <b>Web Analytics</b> 卡片点 <b>Enable</b>。</p>
              <p class="hint">必须从项目页开启；在 Analytics → Web Analytics 里「Add a site」对 Pages 不生效，会出现「已开启但零数据」。</p>
            </div>
          </div>
          <div class="step">
            <div class="step-n">02</div>
            <div class="step-body">
              <h3>触发一次部署，确认 beacon 已注入</h3>
              <p>验证：<code>curl -s <%= siteUrl %> | grep cloudflareinsights</code> 能看到 <code>beacon.min.js</code>。</p>
              <p class="hint">不重新部署，页面里不会有采集脚本，统计会一直为零。</p>
            </div>
          </div>
          <div class="step">
            <div class="step-n">03</div>
            <div class="step-body">
              <h3>取 Site Tag 与 Account ID</h3>
              <p>在 CF 后台打开 Web Analytics 站点的数据概览，地址栏 <code>siteTag~in=…</code> 里的 32 位值就是 <code>CF_SITE_TAG</code>（GraphQL 过滤用）。<b>注意它与 JS 片段 <code>data-cf-beacon</code> 里的 token（site_token）不是同一个值</b>：片段 token 只用于嵌入网页，Site Tag 只用于后台查询，两者不要混填；如两者无法分辨，以 <code>rum/site_info/list</code> 接口返回的 <code>site_tag</code> / <code>site_token</code> 为准。Account ID（32 位十六进制）在 Cloudflare 后台右侧栏，填 <code>CF_ACCOUNT_ID</code>。</p>
            </div>
          </div>
          <div class="step">
            <div class="step-n">04</div>
            <div class="step-body">
              <h3>创建只读分析 Token</h3>
              <p><b>Account API tokens</b> → <b>Create Token</b> → Custom token，权限选 <code>Account / Account Analytics / Read</code>，创建后复制填入 <code>CF_API_TOKEN</code>。</p>
              <p class="hint">在本后台 <a href="/setup" style="color:var(--accent);text-decoration:none">数据设置</a> 页填写并保存，立即生效；也可写进项目根目录 <code>.env</code>（可从 <code>.env.example</code> 复制）。</p>
            </div>
          </div>
        </div>
        <div class="guide-note">
          接通后本页展示近 30 天浏览量与会话数、今日浏览量、7 日趋势、热门页面 Top 6 与流量来源。所有数字都从 Cloudflare GraphQL API 实时拉取，按 <code><%= stats.host %></code> 过滤后直接呈现；本地不存储、不补全，也不生成任何模拟值。
        </div>
      </div>
    </div>
    <aside class="setup-side">
      <div class="check-card">
        <div class="eyebrow">连接状态</div>
        <div class="status-line"><i></i>等待配置</div>
        <div class="checklist">
          <div class="check <%= stats.missing.includes('CF_API_TOKEN') ? '' : 'done' %>"><span class="dot"></span><code>CF_API_TOKEN</code><small><%= stats.missing.includes('CF_API_TOKEN') ? '待填写' : '已配置' %></small></div>
          <div class="check <%= stats.missing.includes('CF_ACCOUNT_ID') ? '' : 'done' %>"><span class="dot"></span><code>CF_ACCOUNT_ID</code><small><%= stats.missing.includes('CF_ACCOUNT_ID') ? '待填写' : '已配置' %></small></div>
          <div class="check <%= stats.missing.includes('CF_SITE_TAG') ? '' : 'done' %>"><span class="dot"></span><code>CF_SITE_TAG</code><small><%= stats.missing.includes('CF_SITE_TAG') ? '待填写' : '已配置' %></small></div>
        </div>
        <div class="card-note">三项齐备后刷新页面，数据会从 Cloudflare 自动拉取；任何一项缺失，本页都不会渲染统计数字。</div>
      </div>
      <div class="check-card">
        <div class="eyebrow">监测目标</div>
        <div class="host-line"><%= stats.host %></div>
        <p style="font-size:11.5px;color:var(--muted);line-height:1.7">统计来自浏览器 beacon，只计入执行 JS 的访客；curl、爬虫与禁 JS 的客户端不计入，数据通常有几分钟延迟。</p>
      </div>
      <div class="preview-strip">
        <div class="eyebrow">接通后将看到 · 布局示意</div>
        <div class="skeleton-grid">
          <div class="skeleton"><span>30 天浏览量</span><i></i></div>
          <div class="skeleton"><span>30 天会话</span><i></i></div>
          <div class="skeleton"><span>今日浏览量</span><i></i></div>
          <div class="skeleton"><span>数据源</span><i></i></div>
        </div>
        <p>此处仅为版式示意，不含任何数字或模拟数据。</p>
      </div>
    </aside>
  </div>
  <% } else if (stats.error) { %>
  <div class="notice err">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 9v4M12 17h.01"/><circle cx="12" cy="12" r="9"/></svg>
    <div><b>凭证已配置，但没能取到数据。</b> <%= stats.error %><br>常见原因：Token 权限不是 <code>Account Analytics / Read</code>、Account ID 或 Site Tag 填错、beacon 尚未注入或刚开启还没数据。</div>
  </div>
  <% } else { %>
  <div class="notice">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 9v4M12 17h.01"/><circle cx="12" cy="12" r="9"/></svg>
    <div>这里是真实访问记录，不是编的；数据可能有几分钟延迟。</div>
  </div>

  <% if (alerts && alerts.length) { %>
  <div class="alerts">
    <% alerts.forEach(function(a){ %>
    <div class="alert <%= a.level %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 9v4M12 17h.01"/><circle cx="12" cy="12" r="9"/></svg>
      <div><b><%= a.title %></b><span><%= a.text %></span></div>
      <% if (a.href) { %><a href="<%= a.href %>"><%= a.action %> →</a><% } %>
    </div>
    <% }) %>
  </div>
  <% } %>

  <div class="toolbar">
    <span>数据更新于 <%= stats.fetchedAt ? stats.fetchedAt.toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' }) : '—' %> · 来自 Cloudflare</span>
    <a class="btn ghost sm" href="/api/export.csv" download>下载表格 CSV</a>
  </div>

  <section class="grid">
    <div class="stat">
      <div class="label">最近30天浏览 <span><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l3-8 4 16 3-8h4"/></svg></span></div>
      <div class="num mono"><%= stats.total %></div>
      <div class="sub">页面被看了几次</div>
    </div>
    <div class="stat">
      <div class="label">最近30天来访 <span><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3.5 3 14.5 0 18M12 3c-3 3.5-3 14.5 0 18"/></svg></span></div>
      <div class="num mono"><%= stats.visits %></div>
      <div class="sub">来了几拨人</div>
    </div>
    <div class="stat">
      <div class="label">今天浏览 <span><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></span></div>
      <div class="num mono"><%= stats.today %></div>
      <div class="sub">从0点算起</div>
    </div>
    <div class="stat">
      <div class="label">数据源 <span><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 5-3.4 8.2-8 9-4.6-.8-8-4-8-9V6l8-3z"/></svg></span></div>
      <div class="num state">已连接</div>
      <div class="sub">GraphQL Analytics API</div>
    </div>
  </section>

  <section class="panels">
    <div class="panel">
      <h2>访问量</h2>
      <div class="desc">看看每天来了多少人</div>
      <div class="seg" role="group" aria-label="选择时间范围">
        <button type="button" class="on" data-range="7">最近7天</button>
        <button type="button" data-range="30">最近30天</button>
      </div>
      <%
      var chartDays = stats.allDays && stats.allDays.length ? stats.allDays : stats.days;
      function drawChart(list, range) {
        var max = range === 30 ? (stats.maxDay30 || 1) : (stats.maxDay || 1);
        var last = list.length - 1;
      %>
      <div class="chart<%= stats.total === 0 ? ' is-empty' : '' %>" data-chart="<%= range %>"<%= range === 30 ? ' hidden' : '' %>>
        <% if (stats.total === 0) { %>
        <div class="chart-empty">
          <div class="ring"><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l5-6 4 3 5-7 4 4"/></svg></div>
          <b>还没有人访问</b>
          <span>有人访问后，这里会显示每天的情况</span>
        </div>
        <% } else { %>
        <% list.forEach(function(d, i){ %>
        <div class="bar-col">
          <div class="v"><%= d.count %></div>
          <div class="bar-track"><% if (d.count > 0) { %><div class="bar <%= i === last ? 'today' : '' %>" style="height:<%= Math.max(6, d.count / max * 88) %>%"></div><% } %></div>
          <div class="x"><%= range === 30 ? ((i % 3 === 0 || i === last) ? d.key.slice(8) : '') : d.label %></div>
        </div>
        <% }) %>
        <% } %>
      </div>
      <% } %>
      <% drawChart(stats.days, 7); %>
      <% drawChart(chartDays, 30); %>
      <% if (stats.total > 0) { %>
      <div class="chart-legend" id="chartLegend"
        data-avg7="<%= Math.round(stats.days.reduce(function(s,d){return s+d.count;},0) / 7) %>"
        data-peak7="<%= stats.maxDay %>"
        data-avg30="<%= Math.round(chartDays.reduce(function(s,d){return s+d.count;},0) / chartDays.length) %>"
        data-peak30="<%= stats.maxDay30 %>">
        <span><i></i>每天平均 <b id="legAvg">—</b> 次</span>
        <span class="today"><i></i>今天 <b><%= stats.today %></b> 次</span>
        <span>最多的一天 <b id="legPeak">—</b> 次</span>
      </div>
      <% } %>
    </div>
    <div class="panel">
      <h2>网站信息</h2>
      <div class="desc">一些基本情况</div>
      <div class="kv"><span>网站地址</span><code><%= stats.host %></code></div>
      <% if (stats.referrers.length) { %>
      <div class="kv" style="margin-top:8px"><span>访客主要来自</span><b><%= stats.referrers[0].host %> · <%= stats.referrers[0].count %> 次</b></div>
      <% } %>
      <% if (stats.devices && stats.devices.length) { %>
      <div class="devices">
        <% var deviceTotal = stats.devices.reduce(function(s, d){ return s + d.count; }, 0); %>
        <% stats.devices.forEach(function(d){ %>
        <div class="device-row">
          <span class="dl"><%= d.label %></span>
          <span class="dbar"><i style="width:<%= (d.count / Math.max(1, deviceTotal) * 100).toFixed(1) %>%"></i></span>
          <span class="dc mono"><%= d.count %></span>
        </div>
        <% }) %>
      </div>
      <% } %>
    </div>
  </section>

  <section class="panel">
    <h2>大家爱看的页面</h2>
    <div class="desc">最近7天看得最多的</div>
    <div class="table-wrap"><table class="table">
      <thead><tr><th>页面</th><th>看了几次</th><th>占比</th></tr></thead>
      <tbody>
        <% if (!stats.topPages.length) { %>
        <tr class="empty-row"><td colspan="3"><div class="empty-icon"><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h10M4 18h7"/></svg></div>近 7 天暂无页面浏览记录</td></tr>
        <% } else { %>
        <% stats.topPages.slice(0,3).forEach(function(p){ %>
        <tr>
          <td class="mono p" title="<%= p.path %>"><%= p.path %></td>
          <td class="mono"><%= p.count %></td>
          <td class="mono"><%= (p.count / Math.max(1, stats.days.reduce((s,d)=>s+d.count,0)) * 100).toFixed(1) %>%</td>
        </tr>
        <% }) %>
        <% } %>
      </tbody>
    </table></div>
    <div class="foot"><span>数据都是真实的，没有编造</span></div>
  </section>

  <section class="panel">
    <h2>访客从哪来</h2>
    <div class="desc">看看大家是怎么找到你的</div>
    <% if (!stats.refRows.length) { %>
    <div class="empty-row" style="padding:24px 0;text-align:center;color:var(--faint);font-size:11.5px">近 7 天暂无来源数据</div>
    <% } else { %>
    <% stats.refRows.forEach(function(r){ %>
    <div class="ref-row">
      <span class="ref-tag <%= r.tone %>"><%= r.channel %></span>
      <span class="host mono"><%= r.host %></span>
      <span class="cnt mono"><%= r.count %> 次</span>
    </div>
    <% }) %>
    <% } %>
    
  </section>
  <% } %>
</main>

<script>
/* ScrollFloat: split into chars and float them up when the band enters view */
(function(){
  var band = document.querySelector('.scroll-float-band');
  var title = band && band.querySelector('[data-scroll-float]');
  if (!band || !title) return;
  var text = title.textContent.trim();
  var chars = [];
  title.textContent = '';
  Array.from(text).forEach(function(ch, i){
    var span = document.createElement('span');
    span.className = 'sf-char';
    span.textContent = ch === ' ' ? '\u00A0' : ch;
    span.style.transitionDelay = (i * 0.03) + 's';
    title.appendChild(span);
    chars.push(span);
  });
  title.setAttribute('aria-label', text);
  if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    band.classList.add('is-visible');
    return;
  }
  if (!('IntersectionObserver' in window)) {
    band.classList.add('is-visible');
    return;
  }
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(entry){
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        io.unobserve(entry.target);
      }
    });
  }, { threshold: 0.3 });
  io.observe(band);
})();

/* 趋势图 7 / 30 天切换：两组柱子都在 DOM 里，只切显示，不重新请求数据 */
(function(){
  var buttons = document.querySelectorAll('.seg button');
  var legend = document.getElementById('chartLegend');
  if (!buttons.length) return;
  function apply(range){
    document.querySelectorAll('[data-chart]').forEach(function(c){
      c.hidden = c.getAttribute('data-chart') !== range;
    });
    if (legend) {
      var avg = document.getElementById('legAvg');
      var peak = document.getElementById('legPeak');
      if (avg) avg.textContent = legend.getAttribute('data-avg' + range);
      if (peak) peak.textContent = legend.getAttribute('data-peak' + range);
    }
  }
  buttons.forEach(function(b){
    b.addEventListener('click', function(){
      buttons.forEach(function(x){ x.classList.toggle('on', x === b); });
      apply(b.getAttribute('data-range'));
    });
  });
  apply('7');
})();

document.getElementById('openSite').addEventListener('click', function(){
  window.open(<%- JSON.stringify(siteUrl) %>, '_blank');
});
</script>
<%- include('theme-ui') %>
</body>
</html>
