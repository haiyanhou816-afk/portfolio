<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#f5f5f7">
<title>线上站点监测 · Portfolio Admin</title>
<%- include('theme-boot') %>
<%- include('admin-style') %>
<style>
.ov-strip{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin:0 0 18px}
.ov-card{background:var(--card);border-radius:14px;box-shadow:var(--shadow);padding:14px 16px;position:relative;overflow:hidden}
.ov-card .k{font-size:10.5px;color:var(--muted);display:flex;align-items:center;justify-content:space-between;gap:6px}
.ov-card .k a{font-size:10px;color:var(--accent);text-decoration:none;font-weight:600}
.ov-card .v{font-size:21px;font-weight:650;letter-spacing:-.6px;margin-top:7px;font-variant-numeric:tabular-nums}
.ov-card .v.bad{color:var(--danger)}
.ov-card .v.small{font-size:13px;font-weight:600;line-height:1.5;word-break:break-all}
.ov-card .s{font-size:10px;color:var(--faint);margin-top:4px;line-height:1.5}
.ref-row{display:flex;align-items:center;gap:10px;padding:9px 0;border-bottom:1px solid var(--line-soft);font-size:11.5px}
.ref-row:last-child{border-bottom:0}
.ref-row .host{flex:1;color:var(--ink-2);word-break:break-all}
.ref-row .cnt{font-variant-numeric:tabular-nums;color:var(--muted);min-width:52px;text-align:right}
.ref-tag{font-size:10px;padding:2px 8px;border-radius:6px;background:var(--fill-1);color:var(--muted);white-space:nowrap}
.ref-tag.ok,.ref-tag.info,.ref-tag.violet{background:var(--accent-soft);color:var(--accent-ink)}
.ref-tag.amber{background:var(--amber-soft);color:var(--ink-2)}
@media(max-width:1100px){.ov-strip{grid-template-columns:repeat(2,1fr)}}
</style>
</head>
<body>

<aside class="side">
  <div class="logo">
    <div class="logo-mark">P</div>
    <div><b>Portfolio Admin</b><small>管理后台 · v1.0</small></div>
  </div>
  <div class="nav-label">监测</div>
  <nav class="nav">
    <a class="on" href="/online"><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3.5 3 14.5 0 18M12 3c-3 3.5-3 14.5 0 18"/></svg>线上站点</a>
    <a href="/monitor"><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 5-3.4 8.2-8 9-4.6-.8-8-4-8-9V6l8-3z"/><path d="M9 12l2 2 4-4"/></svg>入口与安全</a>
    <a href="/dashboard"><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>本地预览</a>
    <a href="/api-explorer"><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M8 4H5a2 2 0 00-2 2v3M16 4h3a2 2 0 012 2v3M8 20H5a2 2 0 01-2-2v-3M16 20h3a2 2 0 002-2v-3"/><circle cx="12" cy="12" r="2.5"/></svg>API 数据</a>
  </nav>
  <div class="nav-label">系统</div>
  <nav class="nav">
    <a href="/health"><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 5-3.4 8.2-8 9-4.6-.8-8-4-8-9V6l8-3z"/><path d="M9 12l2 2 4-4"/></svg>健康检查</a>
    <a href="/setup"><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h9M17 7h3M4 17h3M11 17h9"/><circle cx="15" cy="7" r="2"/><circle cx="9" cy="17" r="2"/></svg>数据源配置</a>
  </nav>
  <div class="side-foot">
    <div class="live"><i></i>服务运行中</div>
    端口 <%= port %> · Cloudflare 数据源
  </div>
</aside>

<main class="main">
  <header class="top">
    <div class="crumb">监测 / <b><%= stats.host %></b></div>
    <div class="top-actions">
      <div class="badge <%= stats.ok ? '' : 'warn' %>"><i></i><%= stats.ok ? 'Cloudflare 已连接' : (stats.configured ? '拉取失败' : '等待配置') %></div>
      <button class="btn ghost" onclick="location.reload()">刷新</button>
      <button class="btn" id="openSite">打开线上站点</button>
    </div>
  </header>

  <div class="source-tabs">
    <a class="on" href="/online">线上站点 · Cloudflare</a>
    <a href="/monitor">入口与安全 · 版本 / 来源 / 爬虫</a>
    <a href="/dashboard">本地预览 · 埋点</a>
    <a href="/health">健康检查</a>
    <a href="/api-explorer">API 数据</a>
    <a href="/setup">数据源配置</a>
  </div>

  <!-- 入口与安全概览：只有聚合数字，不含 IP / UA 明细；明细在受密码保护的 /monitor -->
  <section class="ov-strip">
    <div class="ov-card">
      <div class="k">入口请求 <a href="/monitor">明细 →</a></div>
      <div class="v"><%= overview.total %></div>
      <div class="s">埋点 + 真实 HTTP 请求</div>
    </div>
    <div class="ov-card">
      <div class="k">真人访客 <a href="/monitor#sources">来源 →</a></div>
      <div class="v"><%= overview.humans %></div>
      <div class="s"><%= overview.topChannel ? '主要渠道：' + overview.topChannel.label : '暂无真人访问' %></div>
    </div>
    <div class="ov-card">
      <div class="k">爬虫 / 机器人 <a href="/monitor#threats">标记 →</a></div>
      <div class="v"><%= overview.robots %></div>
      <div class="s">搜索 / AI / 自动化工具</div>
    </div>
    <div class="ov-card">
      <div class="k">可疑 / 攻击 <a href="/monitor#threats">标记 →</a></div>
      <div class="v <%= overview.threats ? 'bad' : '' %>"><%= overview.threats %></div>
      <div class="s">其中攻击尝试 <%= overview.attacks %> 次</div>
    </div>
    <div class="ov-card">
      <div class="k">当前版本 <a href="/monitor#releases">迭代 →</a></div>
      <div class="v small"><%= overview.currentVersion || '尚未上报' %></div>
      <div class="s"><%= overview.lastRelease ? '登记于 ' + overview.lastRelease.deployedAt.toLocaleDateString('zh-CN') : '接入 beacon 后自动追踪' %></div>
    </div>
  </section>

  <% if (!stats.configured) { %>
  <div class="notice">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 9v4M12 17h.01"/><circle cx="12" cy="12" r="9"/></svg>
    <div><b>还没有配置 Cloudflare 凭证，页面不会显示任何数字。</b> 这个后台不会用模拟数据填充空白 —— <a href="/setup" style="color:var(--accent);text-decoration:none;font-weight:600">现在去填写 →</a> 配齐下面三项后，数据直接来自 Cloudflare Web Analytics 的真实浏览器 beacon。</div>
  </div>
  <div class="setup">
    <div class="setup-main">
      <div class="guide">
        <div class="guide-head">
          <div class="eyebrow">Setup · 4 steps</div>
          <h2>接通 Cloudflare 真实数据</h2>
          <p class="lead">目标站点 <code><%= stats.host %></code> 托管在 Cloudflare Pages。数据在 Cloudflare 侧采集，本机只负责读取，不需要公网后端。</p>
        </div>
        <div class="steps">
          <div class="step">
            <div class="step-n">01</div>
            <div class="step-body">
              <h3>从项目页开启 Web Analytics</h3>
              <p>Cloudflare 后台 → <b>Workers &amp; Pages</b> → 打开这个 Pages 项目 → <b>Metrics</b> 标签 → <b>Web Analytics</b> 卡片点 <b>Enable</b>。</p>
              <p class="hint">必须从项目页开启；在 Analytics → Web Analytics 里「Add a site」对 Pages 不生效，会出现「已开启但零数据」。</p>
            </div>
          </div>
          <div class="step">
            <div class="step-n">02</div>
            <div class="step-body">
              <h3>触发一次部署，确认 beacon 已注入</h3>
              <p>验证：<code>curl -s https://<%= stats.host %>/ | grep cloudflareinsights</code> 能看到 <code>beacon.min.js</code>。</p>
              <p class="hint">不重新部署，页面里不会有采集脚本，统计会一直为零。</p>
            </div>
          </div>
          <div class="step">
            <div class="step-n">03</div>
            <div class="step-body">
              <h3>取 Site Tag 与 Account ID</h3>
              <p>在 CF 后台打开 Web Analytics 站点的数据概览，地址栏 <code>siteTag~in=…</code> 里的 32 位值就是 <code>CF_SITE_TAG</code>（GraphQL 过滤用）。<b>注意它与 JS 片段 <code>data-cf-beacon</code> 里的 token（site_token）不是同一个值</b>：片段 token 只用于嵌入网页，Site Tag 只用于后台查询，两者不要混填；如两者无法分辨，以 <code>rum/site_info/list</code> 接口返回的 <code>site_tag</code> / <code>site_token</code> 为准。Account ID（32 位十六进制）在 Cloudflare 后台右侧栏，填 <code>CF_ACCOUNT_ID</code>。</p>
            </div>
          </div>
          <div class="step">
            <div class="step-n">04</div>
            <div class="step-body">
              <h3>创建只读分析 Token</h3>
              <p><b>Account API tokens</b> → <b>Create Token</b> → Custom token，权限选 <code>Account / Account Analytics / Read</code>，创建后复制填入 <code>CF_API_TOKEN</code>。</p>
              <p class="hint">在本后台 <a href="/setup" style="color:var(--accent);text-decoration:none">数据源配置</a> 页填写并保存，立即生效；也可写进项目根目录 <code>.env</code>（可从 <code>.env.example</code> 复制）。</p>
            </div>
          </div>
        </div>
        <div class="guide-note">
          接通后本页展示近 30 天浏览量与会话数、今日浏览量、7 日趋势、热门页面 Top 6 与流量来源。所有数字都从 Cloudflare GraphQL API 实时拉取，按 <code><%= stats.host %></code> 过滤后直接呈现；本地不存储、不补全，也不生成任何模拟值。
        </div>
      </div>
    </div>
    <aside class="setup-side">
      <div class="check-card">
        <div class="eyebrow">连接状态</div>
        <div class="status-line"><i></i>等待配置</div>
        <div class="checklist">
          <div class="check <%= stats.missing.includes('CF_API_TOKEN') ? '' : 'done' %>"><span class="dot"></span><code>CF_API_TOKEN</code><small><%= stats.missing.includes('CF_API_TOKEN') ? '待填写' : '已配置' %></small></div>
          <div class="check <%= stats.missing.includes('CF_ACCOUNT_ID') ? '' : 'done' %>"><span class="dot"></span><code>CF_ACCOUNT_ID</code><small><%= stats.missing.includes('CF_ACCOUNT_ID') ? '待填写' : '已配置' %></small></div>
          <div class="check <%= stats.missing.includes('CF_SITE_TAG') ? '' : 'done' %>"><span class="dot"></span><code>CF_SITE_TAG</code><small><%= stats.missing.includes('CF_SITE_TAG') ? '待填写' : '已配置' %></small></div>
        </div>
        <div class="card-note">三项齐备后刷新页面，数据会从 Cloudflare 自动拉取；任何一项缺失，本页都不会渲染统计数字。</div>
      </div>
      <div class="check-card">
        <div class="eyebrow">监测目标</div>
        <div class="host-line"><%= stats.host %></div>
        <p style="font-size:11.5px;color:var(--muted);line-height:1.7">统计来自浏览器 beacon，只计入执行 JS 的访客；curl、爬虫与禁 JS 的客户端不计入，数据通常有几分钟延迟。</p>
      </div>
      <div class="preview-strip">
        <div class="eyebrow">接通后将看到 · 布局示意</div>
        <div class="skeleton-grid">
          <div class="skeleton"><span>30 天浏览量</span><i></i></div>
          <div class="skeleton"><span>30 天会话</span><i></i></div>
          <div class="skeleton"><span>今日浏览量</span><i></i></div>
          <div class="skeleton"><span>数据源</span><i></i></div>
        </div>
        <p>此处仅为版式示意，不含任何数字或模拟数据。</p>
      </div>
    </aside>
  </div>
  <% } else if (stats.error) { %>
  <div class="notice err">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 9v4M12 17h.01"/><circle cx="12" cy="12" r="9"/></svg>
    <div><b>凭证已配置，但没能取到数据。</b> <%= stats.error %><br>常见原因：Token 权限不是 <code>Account Analytics / Read</code>、Account ID 或 Site Tag 填错、beacon 尚未注入或刚开启还没数据。</div>
  </div>
  <% } else { %>
  <div class="notice">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 9v4M12 17h.01"/><circle cx="12" cy="12" r="9"/></svg>
    <div><b>数据来自 Cloudflare Web Analytics 的真实浏览器 beacon，已按 <code><%= stats.host %></code> 过滤。</b> 只统计执行了 JS 的浏览器访问（curl、爬虫、禁 JS 的访客不计入），数据通常有几分钟延迟；结果在本机缓存 60 秒。</div>
  </div>

  <section class="grid">
    <div class="stat">
      <div class="label">近 30 天浏览量 <span><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l3-8 4 16 3-8h4"/></svg></span></div>
      <div class="num mono"><%= stats.total %></div>
      <div class="sub"><em>真实 PV</em> · 来自 beacon</div>
    </div>
    <div class="stat">
      <div class="label">近 30 天会话 <span><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3.5 3 14.5 0 18M12 3c-3 3.5-3 14.5 0 18"/></svg></span></div>
      <div class="num mono"><%= stats.visits %></div>
      <div class="sub">Cloudflare sum.visits</div>
    </div>
    <div class="stat">
      <div class="label">今日浏览量 <span><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.2"/><path d="M3 20c0-3.3 2.7-5.5 6-5.5s6 2.2 6 5.5"/></svg></span></div>
      <div class="num mono"><%= stats.today %></div>
      <div class="sub">按 UTC 日期统计</div>
    </div>
    <div class="stat">
      <div class="label">数据源 <span><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 5-3.4 8.2-8 9-4.6-.8-8-4-8-9V6l8-3z"/></svg></span></div>
      <div class="num state">已连接</div>
      <div class="sub">GraphQL Analytics API</div>
    </div>
  </section>

  <section class="panels">
    <div class="panel">
      <h2>浏览趋势</h2>
      <div class="desc">最近 7 天真实浏览量 · 近 30 天共 <%= stats.total %> 次</div>
      <div class="chart<%= stats.total === 0 ? ' is-empty' : '' %>">
        <% if (stats.total === 0) { %>
        <div class="chart-empty">
          <div class="ring"><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l5-6 4 3 5-7 4 4"/></svg></div>
          <b>还没有浏览数据</b>
          <span>beacon 开始上报后，这里会显示近 7 天趋势</span>
        </div>
        <% } else { %>
        <% stats.days.forEach(function(d, i){ %>
        <div class="bar-col">
          <div class="v"><%= d.count %></div>
          <div class="bar-track"><% if (d.count > 0) { %><div class="bar <%= i === 6 ? 'today' : '' %>" style="height:<%= Math.max(6, d.count / stats.maxDay * 88) %>%"></div><% } %></div>
          <div class="x"><%= d.label %></div>
        </div>
        <% }) %>
        <% } %>
      </div>
      <% if (stats.total > 0) { %>
      <div class="chart-legend">
        <% var sum = 0, peak = 0; stats.days.forEach(function(d){ sum += d.count; if (d.count > peak) peak = d.count; }); %>
        <span><i></i>近 7 日 · 日均 <b><%= (sum / 7).toFixed(1) %></b> 次</span>
        <span class="today"><i></i>今日 <b><%= stats.today %></b> 次</span>
        <span>单日峰值 <b><%= peak %></b> 次</span>
      </div>
      <% } %>
    </div>
    <div class="panel">
      <h2>数据源信息</h2>
      <div class="desc">Cloudflare Web Analytics · RUM</div>
      <div class="kv"><span>监测站点</span><code><%= stats.host %></code></div>
      <div class="kv"><span>数据集</span><code>rumPageloadEvents</code></div>
      <div class="kv"><span>过滤维度</span><b>requestHost</b></div>
      <div class="kv"><span>统计口径</span><b>count / sum.visits</b></div>
      <div class="kv"><span>缓存</span><b>60 秒</b></div>
      <div class="kv"><span>最近拉取</span><b class="mono"><%= stats.fetchedAt.toLocaleString('zh-CN', { hour12: false }) %></b></div>
      <% if (stats.referrers.length) { %>
      <div class="kv" style="margin-top:8px"><span>主要来源</span><b><%= stats.referrers[0].host %> · <%= stats.referrers[0].count %></b></div>
      <% } %>
    </div>
  </section>

  <section class="panel">
    <h2>热门页面</h2>
    <div class="desc">近 7 天浏览最多的页面 · 已排除其他主机名</div>
    <div class="table-wrap"><table class="table">
      <thead><tr><th>页面路径</th><th>浏览量</th><th>占比</th><th>来源站点</th></tr></thead>
      <tbody>
        <% if (!stats.topPages.length) { %>
        <tr class="empty-row"><td colspan="4"><div class="empty-icon"><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h10M4 18h7"/></svg></div>近 7 天暂无页面浏览记录</td></tr>
        <% } else { %>
        <% stats.topPages.forEach(function(p){ %>
        <tr>
          <td class="mono p" title="<%= p.path %>"><%= p.path %></td>
          <td class="mono"><%= p.count %></td>
          <td class="mono"><%= (p.count / Math.max(1, stats.days.reduce((s,d)=>s+d.count,0)) * 100).toFixed(1) %>%</td>
          <td><%= stats.host %></td>
        </tr>
        <% }) %>
        <% } %>
      </tbody>
    </table></div>
    <div class="foot"><span>数据实时拉取自 Cloudflare，不在本地伪造或补全</span><span>本地预览数据见 <a href="/dashboard" style="color:var(--accent);text-decoration:none">/dashboard</a></span></div>
  </section>

  <section class="panel">
    <h2>流量来源</h2>
    <div class="desc">近 7 天 Cloudflare refererHost · 按渠道自动归类；更细的 UTM、落地页与访客入口见 <a href="/monitor#sources" style="color:var(--accent);text-decoration:none">入口与安全监测</a></div>
    <% if (!stats.refRows.length) { %>
    <div class="empty-row" style="padding:24px 0;text-align:center;color:var(--faint);font-size:11.5px">近 7 天暂无来源数据</div>
    <% } else { %>
    <% stats.refRows.forEach(function(r){ %>
    <div class="ref-row">
      <span class="ref-tag <%= r.tone %>"><%= r.channel %></span>
      <span class="host mono"><%= r.host %></span>
      <span class="cnt mono"><%= r.count %> 次</span>
    </div>
    <% }) %>
    <% } %>
    <div class="foot"><span>来源分类与 /monitor 使用同一套渠道字典</span><span>Cloudflare 只统计执行 JS 的浏览器</span></div>
  </section>
  <% } %>
</main>

<script>
document.getElementById('openSite').addEventListener('click', function(){
  window.open('https://<%= stats.host %>/', '_blank');
});
</script>
<%- include('theme-ui') %>
</body>
</html>
