  position:absolute;top:calc(100% + 12px);right:0;width:288px;max-width:calc(100vw - 32px);
  background:var(--pop-bg);border:1px solid var(--line-soft);border-radius:18px;
  padding:18px 18px 16px;box-shadow:var(--shadow-hover);z-index:80;
  -webkit-backdrop-filter:saturate(180%) blur(24px);
  backdrop-filter:saturate(180%) blur(24px);
}
