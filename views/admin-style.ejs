<script>
/* NAV_SHARECODE_FIX · 导航链接自动携带 sharecode
   平台分享链接靠 URL 参数鉴权，站内裸链接（/api-explorer、/monitor 等）
   不带参数会掉进解锁页。这里在页面加载后给所有站内链接补上当前 sharecode。 */
(function(){
  try{
    var m = new URLSearchParams(location.search);
    var sc = (m.get('sharecode') || '').trim();
    if(!sc) return;
    var APP_PATHS = /^\/(online|dashboard|monitor|api-explorer|health|setup)([?#]|$)/;
    function fix(){
      document.querySelectorAll('a[href]').forEach(function(a){
        var h = a.getAttribute('href') || '';
        if(!APP_PATHS.test(h)) return;
        if(/[?&]sharecode=/.test(h)) return;
        var u;
        try{ u = new URL(h, location.origin); }catch(e){ return; }
        if(!u.searchParams.has('sharecode')) u.searchParams.set('sharecode', sc);
        a.setAttribute('href', u.pathname + u.search + u.hash);
      });
    }
    if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fix);
    else fix();
  }catch(e){}
})();
</script>

