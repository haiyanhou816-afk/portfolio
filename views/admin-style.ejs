  .chart-empty span{font-size:11.5px;max-width:100%}
  .panel .desc{margin-bottom:18px;overflow-wrap:anywhere}
  .chart-legend{gap:12px;font-size:11.5px}
  .guide{padding:24px 20px;border-radius:16px}
  .guide-head h2{font-size:21px}
  .step{gap:14px}
  .step-n{width:31px;height:31px;flex-basis:31px;font-size:11px}
  .steps::before{left:15px}
  .setup-side{display:flex}
  .skeleton-grid{grid-template-columns:1fr 1fr}
  .preview-strip{padding:20px}
  .health-hero{padding:22px 20px;gap:14px;flex-wrap:wrap}
  .health-hero .hc-mark{width:46px;height:46px;flex-basis:46px;border-radius:15px}
  .health-hero h2{font-size:20px}
  .health-hero .hc-meta{margin-left:0;width:100%;text-align:left;white-space:normal}
  .api-grid{grid-template-columns:1fr;gap:14px}
  .json-card{padding:18px 16px;border-radius:16px}
  .json-head{flex-wrap:wrap;gap:8px}
  .json-tools{width:100%}
  pre.json{font-size:10.5px;max-height:220px;padding:13px}
  .ep-row{flex-wrap:wrap;gap:8px}
  .ep-main{flex:1 1 calc(100% - 62px)}
  .ep-tag{margin-left:auto}
  .toolbar input[type="search"]{min-width:0;flex:1 1 100%}
  .table-scroll{max-height:420px}
  /* 小屏隐藏首次引导气泡，避免遮挡顶栏与标签栏；外观按钮本身仍完整可见 */
  .theme-tip{display:none!important}
  /* 小屏把外观面板做成底部弹层，避免溢出屏幕 */
  .theme-pop{position:fixed;left:16px;right:16px;bottom:16px;top:auto;width:auto;max-width:none}
}

