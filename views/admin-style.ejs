  .source-tabs{gap:2px;margin-bottom:22px;overflow-x:auto;max-width:100%}
  .source-tabs a{padding:8px 13px;font-size:12px}
  .notice{font-size:12.5px;padding:14px 15px;margin-bottom:20px}
  .stat{padding:18px 18px 20px;border-radius:16px}
  .stat .num{font-size:34px;margin-top:15px;letter-spacing:-1.5px}
  .stat .num.state{font-size:23px;margin-top:20px}
  .stat .label{font-size:11.5px}
  .stat .label span{width:27px;height:27px}
  .panel{padding:20px 18px;border-radius:16px}
  .panel h2{font-size:16px}
  /* 小屏 .panels 变单列后不再被 grid 拉伸，flex:1(basis:0) 会把图表压到约 66px，
     空状态内容因此溢出、被下一张卡片盖住。改为固定高度并加最小高度兜底。 */
  .chart{flex:0 0 auto;height:166px;min-height:166px;gap:7px}
  .chart-empty{gap:9px;padding:0 12px}
