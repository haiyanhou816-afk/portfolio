.tp-swatch.default{background:linear-gradient(135deg,#0071e3 50%,#0a84ff 50%)}
.tp-custom{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:14px;font-size:11.5px;color:var(--muted)}
