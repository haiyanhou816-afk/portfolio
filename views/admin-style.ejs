@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}

/* ---------- 响应式 ---------- */
@media (max-width:1180px){.setup{grid-template-columns:minmax(0,1fr) 264px}.main{padding:0 32px 64px}}
@media (max-width:1100px){.grid{grid-template-columns:repeat(2,1fr)}.panels{grid-template-columns:1fr}.setup{grid-template-columns:1fr}.setup-side{display:grid;grid-template-columns:1fr 1fr}.setup-side .preview-strip{grid-column:1/-1}.skeleton-grid{grid-template-columns:repeat(4,1fr)}}
@media (max-width:720px){
  .side{display:none}
  .main{padding:0 20px 48px}
  .grid{grid-template-columns:1fr 1fr;gap:12px}
  /* 单列时 1fr = minmax(auto,1fr)，会被长 URL 顶成 ~480px，导致整页被手机缩放 */
  .panels{grid-template-columns:minmax(0,1fr);gap:14px}
  .top{min-height:0;flex-wrap:wrap;gap:14px;padding:20px 0 18px;margin-bottom:20px}
